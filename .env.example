# Copia este archivo como .env.local y llena los valores. .env.local nunca se commitea.

# URL pública del sitio (sin "/" final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://constructorarocafuerte.com

# Supabase (proyecto propio del portal, separado de los bots)
# Públicas: llegan al navegador. La publishable key (sb_publishable_...) está hecha para eso;
# con RLS activado y sin políticas no puede leer ni escribir la tabla leads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOLO SERVIDOR (sb_secret_...). Salta RLS. Nunca en código cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
